# =========================================================================
# FlowBot AI Studio — environment variables
# Copy this file to `.env` (worker) or configure secrets in Cloudflare.
# NEVER commit real secrets. All values here are placeholders.
# =========================================================================

# --- Cloudflare Worker secrets (set via `wrangler secret put <NAME>`) ---
# Master encryption key for the credential vault (AES-256-GCM).
# Generate with: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=

# Auth session signing secret (HMAC-SHA256). Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# App base URL (public origin of the Worker, e.g. https://flowbot.example.com)
APP_BASE_URL=

# CORS allowed origins (comma separated). For local dev use http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8100

# JSON Web Key Set URL for optional external OAuth/OIDC providers (optional)
OAUTH_JWKS_URL=

# --- Zilliz (vector / semantic search) — OPTIONAL, server-side only ---
# ZILLIZ_ENDPOINT is the Zilliz Cloud REST base URL (a Worker variable).
# ZILLIZ_API_KEY is the API key and MUST be set as a Cloudflare Worker secret
# (`wrangler secret put ZILLIZ_API_KEY`). It is read only from env.ZILLIZ_API_KEY
# server-side and never exposed to the browser. When absent, vector nodes
# degrade gracefully with a clear "not configured" error.
ZILLIZ_ENDPOINT=
ZILLIZ_API_KEY=
ZILLIZ_COLLECTION=flowbot_chunks

# --- Telegram (optional; tokens may instead be provided per-bot in the UI) ---
# Used to register webhooks with the Telegram Bot API on behalf of the account
# owner. Per-bot tokens are stored encrypted in the D1 credential vault.
TELEGRAM_API_URL=https://api.telegram.org

# --- Frontend (web/.env) ---
# Public Worker API base URL used by the PWA at build/dev time.
VITE_API_BASE_URL=http://localhost:8787