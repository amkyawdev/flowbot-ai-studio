{
  "name": "flowbot-web",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs && node scripts/gen-android-icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run build && cd android && ./gradlew :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@flowbot/shared": "*",
    "@xyflow/react": "^12.3.5",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
